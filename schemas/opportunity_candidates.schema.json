{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-audit.local/schemas/opportunity_candidates.schema.json",
  "title": "AI Audit opportunity candidates",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["title", "problem", "proposed_solution", "evidence_refs"],
    "properties": {
      "opportunity_id": {"type": "string", "minLength": 1},
      "title": {"type": "string", "minLength": 1},
      "problem": {"type": "string", "minLength": 1},
      "proposed_solution": {"type": "string", "minLength": 1},
      "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "process_refs": {"type": "array", "items": {"type": "string"}},
      "dependencies": {"type": "array", "items": {"type": "string"}},
      "implementation_effort": {"type": "string"},
      "timeline": {"type": "string"},
      "involves_ai": {"type": "boolean"},
      "data_categories": {"type": "array", "items": {"type": "string"}},
      "confidence_level": {"enum": ["low", "medium", "high"]},
      "confidence_rationale": {"type": "string"},
      "business_impact": {"type": "object"},
      "priority_dimensions": {"type": "object"},
      "assumptions": {"type": "array", "items": {"type": "string"}},
      "existing_controls": {"type": "array", "items": {"type": "string"}},
      "risk_controls_validated": {"type": "boolean"},
      "roi_inputs": {"type": "object"},
      "process": {"type": "object"}
    },
    "additionalProperties": true
  }
}
